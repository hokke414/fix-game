  instructions:
  - "\u8D64\u3044\u4E38\u30DC\u30BF\u30F3\u3092\u3064\u304B\u3093\u3067\u3001\u96FB\u6E90\u3092\u5207\u308D\u3046"
  - "\u9EC4\u8272\u306E\u30C1\u30A7\u30C3\u30AB\u30FC\u3092\u3001\u5DE6\u4E0A\u306E\u7D2B\u306E\u4E38\u306B\u5F53\u3066\u3088\u3046"
  - "\u7D2B\u306E\u30B3\u30FC\u30C9\u3092\u3001\u5DE6\u4E0B\u306E\u6A2A\u9577\u306E\u7A74\u306B\u5F53\u3066\u3088\u3046"
  - "\u30AA\u30EC\u30F3\u30B8\u306E\u30C1\u30A7\u30C3\u30AB\u30FC\u3092\u3001\u771F\u3093\u4E2D\u4E0A\u306E\u4E38\u306B\u5F53\u3066\u3088\u3046"
  - "\u30D4\u30F3\u30AF\u306E\u77ED\u3044\u68D2\u3092\u3001\u771F\u3093\u4E2D\u4E0B\u306E\u6A2A\u9577\u306E\u5834\u6240\u306B\u5F53\u3066\u3088\u3046"
  - "\u8D64\u3044\u30C9\u30E9\u30A4\u30D0\u30FC\u3092\u3001\u53F3\u4E0A\u306E\u9280\u8272\u306E\u306D\u3058\u306B\u5F53\u3066\u3088\u3046"
  - "\u7DD1\u306E\u677F\u3092\u3001\u53F3\u4E0B\u306E\u56DB\u89D2\u3044\u5834\u6240\u306B\u5F53\u3066\u3088\u3046"
  - "\u53F3\u4E0A\u306E\u7DD1\u306E\u30EC\u30D0\u30FC\u3092\u3064\u304B\u3093\u3067\u3001\u52D5\u304D\u3092\u78BA\u304B\u3081\u3088\u3046"
  hints:
  - "\u767D\u3044\u96FB\u6E90\u30DE\u30FC\u30AF\u304C\u4ED8\u3044\u305F\u8D64\u3044\u4E38\u30DC\u30BF\u30F3\u3067\u3059"
  - "\u9ED2\u3044\u753B\u9762\u30682\u672C\u306E\u7D30\u3044\u68D2\u304C\u3042\u308B\u9EC4\u8272\u306E\u9053\u5177\u3067\u3059"
